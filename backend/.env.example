# Any OpenAI-compatible provider. Defaults below are for Groq
# (get a key at https://console.groq.com/keys).
LLM_API_KEY=gsk_...

# Optional overrides
# LLM_MODEL=openai/gpt-oss-20b
# LLM_BASE_URL=https://api.groq.com/openai/v1
#
# Examples for other providers:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY can be any text)

# --- Protecting the server (all optional) ---
# If set, every /api/ask call must send this in an X-API-Key header. Unset = open (dev only).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_API_KEY=
# Per-client limits (each question costs LLM quota):
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=200
# Cap on user-triggered Open-Meteo lookups per day (free tier allows 10,000 total):
# UPSTREAM_ON_DEMAND_PER_DAY=500
